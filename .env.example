APP_ENV=development
# Use a dedicated MySQL account with only the required application privileges.
DB_HOST=127.0.0.1
DB_NAME=iforgot_dev
DB_USER=iforgot_app
DB_PASSWORD=

# Generate a unique key with this command and store it in the deployment secret manager:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Never commit the generated key or put it in application source code.
PASSWORD_RESET_HMAC_KEY=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=iForgot
